# ==============================================================================
# GitOps Infrastructure & Argo CD - Central Environment Configuration
# ==============================================================================
# Copy this file to '.env' at the project root and adjust values as needed:
#   cp .env.example .env
#
# Variables support bash interpolation (e.g. ARGOCD_DOMAIN="argocd.${MAIN_DOMAIN}").
# If an environment variable is already exported in your shell or CI/CD, that value
# takes precedence over the defaults defined below.
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Base Domain & Ingress Hostnames
# ------------------------------------------------------------------------------
# Primary base domain used throughout local DNS and Gateway API routes
MAIN_DOMAIN="${MAIN_DOMAIN:-chetan.local}"

# Derived Service FQDNs (Do not repeat domains manually)
ARGOCD_DOMAIN="${ARGOCD_DOMAIN:-argocd.${MAIN_DOMAIN}}"
HARBOR_DOMAIN="${HARBOR_DOMAIN:-cr.${MAIN_DOMAIN}}"
FORGEJO_DOMAIN="${FORGEJO_DOMAIN:-git.${MAIN_DOMAIN}}"
DEV_DOMAIN="${DEV_DOMAIN:-*.dev.${MAIN_DOMAIN}}"
ZABBIX_DOMAIN="${ZABBIX_DOMAIN:-zabbix.${MAIN_DOMAIN}}"
ZABBIX_SRV_DOMAIN="${ZABBIX_SRV_DOMAIN:-zbx-srv.${MAIN_DOMAIN}}"
ZABBIX_PROXY_DOMAIN="${ZABBIX_PROXY_DOMAIN:-zbx-proxy.${MAIN_DOMAIN}}"

# Host aliases for scripts expecting *_HOST
ARGOCD_HOST="${ARGOCD_HOST:-${ARGOCD_DOMAIN}}"
HARBOR_HOST="${HARBOR_HOST:-${HARBOR_DOMAIN}}"
FORGEJO_HOST="${FORGEJO_HOST:-${FORGEJO_DOMAIN}}"
ZABBIX_HOST="${ZABBIX_HOST:-${ZABBIX_DOMAIN}}"
ZABBIX_SRV_HOST="${ZABBIX_SRV_HOST:-${ZABBIX_SRV_DOMAIN}}"
ZABBIX_PROXY_HOST="${ZABBIX_PROXY_HOST:-${ZABBIX_PROXY_DOMAIN}}"

# ------------------------------------------------------------------------------
# 2. Local KinD Cluster Configuration
# ------------------------------------------------------------------------------
CLUSTER_NAME="${CLUSTER_NAME:-gitops-demo-cluster}"
DEFAULT_CLUSTER="${DEFAULT_CLUSTER:-${CLUSTER_NAME}}"

# ------------------------------------------------------------------------------
# 3. Bootstrap Installation Mode
# ------------------------------------------------------------------------------
# Options: 'online' (default) or 'airgap'
# If left blank, main.sh automatically detects connectivity via live internet probe.
INSTALL_MODE="${INSTALL_MODE:-online}"

# ------------------------------------------------------------------------------
# 4. Kubernetes Namespaces
# ------------------------------------------------------------------------------
ARGOCD_NAMESPACE="${ARGOCD_NAMESPACE:-argocd}"
TRAEFIK_NAMESPACE="${TRAEFIK_NAMESPACE:-traefik}"
CERT_MANAGER_NAMESPACE="${CERT_MANAGER_NAMESPACE:-cert-manager}"
HARBOR_NAMESPACE="${HARBOR_NAMESPACE:-harbor}"
FORGEJO_NAMESPACE="${FORGEJO_NAMESPACE:-forgejo}"
FORGEJO_RUNNER_NAMESPACE="${FORGEJO_RUNNER_NAMESPACE:-forgejo-runner}"
ZABBIX_NAMESPACE="${ZABBIX_NAMESPACE:-zabbix}"

# ------------------------------------------------------------------------------
# 5. Zabbix Monitoring Platform Configuration (TimescaleDB, Proxy, Agent 2)
# ------------------------------------------------------------------------------
ZABBIX_ADMIN_USER="${ZABBIX_ADMIN_USER:-Admin}"
ZABBIX_ADMIN_PASSWORD="${ZABBIX_ADMIN_PASSWORD:-zabbix}"
ZABBIX_DB_PASSWORD="${ZABBIX_DB_PASSWORD:-Zabbix12345}"
ZABBIX_IMAGE_TAG="${ZABBIX_IMAGE_TAG:-alpine-7.4.15}"
ZABBIX_CHART_VERSION="${ZABBIX_CHART_VERSION:-7.1.0}"

# ------------------------------------------------------------------------------
# 5. In-Cluster Forgejo Git Service & Infrastructure GitOps Repo
# ------------------------------------------------------------------------------
FORGEJO_USER="${FORGEJO_USER:-forgejo_admin}"
FORGEJO_PASS="${FORGEJO_PASS:-Forgejo12345}"
FORGEJO_REPO_NAME="${FORGEJO_REPO_NAME:-gitops-argocd-infra}"
GIT_REMOTE_NAME="${GIT_REMOTE_NAME:-forgejo}"
FORGEJO_INTERNAL_PORT="${FORGEJO_INTERNAL_PORT:-3000}"

# In-cluster Kubernetes internal DNS URL for Argo CD and runner connectivity
FORGEJO_INTERNAL_URL="${FORGEJO_INTERNAL_URL:-http://forgejo-http.${FORGEJO_NAMESPACE}.svc.cluster.local:${FORGEJO_INTERNAL_PORT}/${FORGEJO_USER}/${FORGEJO_REPO_NAME}.git}"
FORGEJO_INSTANCE_URL="${FORGEJO_INSTANCE_URL:-http://forgejo-http.${FORGEJO_NAMESPACE}.svc.cluster.local:${FORGEJO_INTERNAL_PORT}}"
FORGEJO_REPO_SECRET_NAME="${FORGEJO_REPO_SECRET_NAME:-forgejo-infra-repo-secret}"
FORGEJO_RUNNER_SECRET_NAME="${FORGEJO_RUNNER_SECRET_NAME:-forgejo-runner-secret}"

# ------------------------------------------------------------------------------
# 6. Workload Applications Repository & Credentials (Step 07)
# ------------------------------------------------------------------------------
# Target Git Repository URL for application workloads (Helm microservices)
REPO_URL="${REPO_URL:-https://github.com/erchetansoni/gitops-argocd-apps.git}"
GITHUB_REPO_URL="${GITHUB_REPO_URL:-${REPO_URL}}"

# GitHub Username and Personal Access Token (PAT) with read access to REPO_URL
GITHUB_USERNAME="${GITHUB_USERNAME:-erchetansoni}"
GITHUB_USER="${GITHUB_USER:-${GITHUB_USERNAME}}"
GITHUB_TOKEN="${GITHUB_TOKEN:-}"

# Argo CD Secret Name for workload repository credentials
REPO_SECRET_NAME="${REPO_SECRET_NAME:-repo-creds-secret}"

# ------------------------------------------------------------------------------
# 7. Gateway API & TLS Certificate Configuration
# ------------------------------------------------------------------------------
GATEWAY_CLASS_NAME="${GATEWAY_CLASS_NAME:-traefik}"
GATEWAY_NAME="${GATEWAY_NAME:-main-gateway}"
DOMAIN_CERT_SECRET_NAME="${DOMAIN_CERT_SECRET_NAME:-domain-certificate-tls-secret}"
SECRET_NAME="${SECRET_NAME:-${DOMAIN_CERT_SECRET_NAME}}"
SECRET_NAMESPACE="${SECRET_NAMESPACE:-default}"

# Self-Signed Root CA & Wildcard Certificate Generator Parameters
CA_COMMON_NAME="${CA_COMMON_NAME:-Local Root CA}"
CA_VALIDITY_DAYS="${CA_VALIDITY_DAYS:-3650}"       # 10 Years
CERT_VALIDITY_DAYS="${CERT_VALIDITY_DAYS:-1825}"   # 5 Years
CERT_COUNTRY="${CERT_COUNTRY:-IN}"
CERT_STATE="${CERT_STATE:-Madhya Pradesh}"
CERT_LOCALITY="${CERT_LOCALITY:-Bhopal}"
CERT_ORGANIZATION="${CERT_ORGANIZATION:-Local Infra}"
CERT_ORGANIZATIONAL_UNIT="${CERT_ORGANIZATIONAL_UNIT:-ArgoCD & Kubernetes}"

# ------------------------------------------------------------------------------
# 8. Air-Gap Packaging & Container Image Loader
# ------------------------------------------------------------------------------
TARGET_PLATFORM="${TARGET_PLATFORM:-linux/amd64}"
IMAGES_FILE="${IMAGES_FILE:-airgap/images.yaml}"
AIRGAP_TAR_OUTPUT="${AIRGAP_TAR_OUTPUT:-airgap/airgap-images.tar}"
