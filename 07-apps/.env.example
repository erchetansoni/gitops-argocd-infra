# ==============================================================================
# GitOps & Argo CD Environment Configuration
# ==============================================================================
# Note: You can place your .env file here (05-apps/.env) or at project root (.env).
# The scripts will look in both locations automatically.
# ==============================================================================

# Target Git Repository URL (HTTPS)
REPO_URL="https://github.com/erchetansoni/gitops-argocd-apps.git"

# GitHub Username
GITHUB_USERNAME="erchetansoni"

# GitHub Personal Access Token (PAT) with read access to the repo
GITHUB_TOKEN=""

# Argo CD Secret Name for repository credentials
REPO_SECRET_NAME="repo-creds-secret"

# Argo CD Namespace
ARGOCD_NAMESPACE="argocd"

# Argo CD Host / Ingress URL
ARGOCD_HOST="argocd.chetan.local"
