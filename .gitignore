# Environment files and credentials (never commit secrets!)
.env
.env.local
.env.*.local
*.env
!*.env.example
07-apps/.env

# Certificate files and private keys (never commit secrets / generated PKI to git)
04-traefik-gateway/cert/tls-generator/ca-store/*
04-traefik-gateway/cert/tls-generator/server/*
04-traefik-gateway/cert/tls-generator/client/*
04-traefik-gateway/cert/tls-generator/output/*

# Preserve directory structure with .gitkeep
!04-traefik-gateway/cert/tls-generator/ca-store/.gitkeep
!04-traefik-gateway/cert/tls-generator/server/.gitkeep
!04-traefik-gateway/cert/tls-generator/client/.gitkeep
!04-traefik-gateway/cert/tls-generator/output/.gitkeep

# Track scripts in server and client
!04-traefik-gateway/cert/tls-generator/server/*.sh
!04-traefik-gateway/cert/tls-generator/server/*.ps1
!04-traefik-gateway/cert/tls-generator/client/*.sh
!04-traefik-gateway/cert/tls-generator/client/*.ps1

# Log files
*.log

# Temporary / OS files
.DS_Store
Thumbs.db
*.swp
*~
